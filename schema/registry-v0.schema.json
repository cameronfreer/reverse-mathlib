{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cameronfreer/reverse-mathlib/schema/registry-v0.schema.json",
  "title": "reverse-mathlib direct catalog (v0)",
  "description": "DOCUMENTED schema (custom checks in rmlib-zoo validate invariants; full machine validation arrives with the first Python dependency). TRANSITIONAL: the #3/#4 conceptual and variant layers are present; catalog/v1 is published once the presentations issue (#17) stabilizes the ontology. Canonical extraction of the registry's persistent extension state. Set-like arrays are canonically sorted; order-bearing arrays (evidence) preserve declared order since evidenceIdx refers to it. Machine fields carry stable tags; human labels live in display objects. No timestamps. The ambientGraph section contains kernel-checked relative certificates in unrestricted Lean; nothing in it is a reverse-mathematics implication.",
  "type": "object",
  "required": [
    "schema",
    "dependencies",
    "concepts",
    "semanticLayers",
    "statementVariants",
    "uniformProblems",
    "externalNamespaces",
    "externalRefs",
    "baseTheories",
    "formulaClasses",
    "reducibilityNotions",
    "facts",
    "semanticContexts",
    "ports",
    "ambientGraph"
  ],
  "properties": {
    "schema": {
      "const": "reverse-mathlib.catalog/v0"
    },
    "dependencies": {
      "type": "object",
      "required": [
        "leanVersion",
        "mathlibRevision"
      ],
      "properties": {
        "leanVersion": {
          "type": "string"
        },
        "mathlibRevision": {
          "type": "string",
          "description": "Pinned mathlib revision, or the explicit string \"unavailable\"."
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target",
          "portDecl",
          "relation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mathlibDecl": {
            "type": [
              "string",
              "null"
            ]
          },
          "mathlibModule": {
            "type": [
              "string",
              "null"
            ]
          },
          "portDecl": {
            "type": [
              "string",
              "null"
            ]
          },
          "relation": {
            "enum": [
              "proofAnalogue",
              "minedArchitecture",
              "exactSpecialization",
              "conceptualAnalogue"
            ]
          },
          "literatureNote": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "direction",
                "verification",
                "ambient",
                "semanticScope",
                "display"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "dependencyAudit",
                    "frontierSlice",
                    "relativeProof",
                    "fragmentCheck",
                    "semanticImplication",
                    "syntacticDerivation"
                  ]
                },
                "direction": {
                  "enum": [
                    "upper",
                    "lower",
                    "exact"
                  ]
                },
                "verification": {
                  "enum": [
                    "claimed",
                    "kernelChecked",
                    "backendChecked"
                  ]
                },
                "ambient": {
                  "enum": [
                    "lean",
                    "checkedFragment",
                    "modelSemantics",
                    "objectTheory"
                  ]
                },
                "context": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Registered semantic context of semanticImplication evidence; null otherwise."
                },
                "theory": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "route": {
                  "enum": [
                    "direct",
                    "semanticCompleteness",
                    "fragmentInterpretation",
                    "importedChecked",
                    null
                  ],
                  "description": "syntacticDerivation only: how provability was obtained (provenance)."
                },
                "artifact": {
                  "enum": [
                    "propositionOnly",
                    "derivationObject",
                    "serializedCheckedCode",
                    null
                  ],
                  "description": "syntacticDerivation only: what derivation artifact survives. A Prop-level derivation is erased however obtained; extraction needs derivationObject or serializedCheckedCode."
                },
                "certificate": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "assumes": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Serialized statement-variant id taken as hypothesis."
                },
                "fact": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "semanticImplication only: cross-link to the typed fact this evidence supports (display/provenance; never inflates the fact-level headline)."
                },
                "note": {
                  "type": "string"
                },
                "semanticScope": {
                  "enum": [
                    "fullStandardModel",
                    "omegaModels",
                    "allModels",
                    null
                  ]
                },
                "display": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            }
          },
          "display": {
            "type": "object"
          },
          "target": {
            "type": "string",
            "pattern": "^reverse-mathlib:",
            "description": "The exact statement variant this port targets; portDecl is derived from its interface."
          }
        },
        "additionalProperties": false
      }
    },
    "semanticContexts": {
      "type": "array",
      "description": "Registered semantic contexts (issue #6): the typed targets of scoped semantic certificates. Each ties a base theory and a scope (omegaModels | allModels; never provability) to the Lean base-context predicate contextDecl : Model -> Prop, at a semantic layer whose interfaceSchema fixes Model. Kernel-checked semanticImplication evidence validates against the exact registered context.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "base",
          "scope",
          "layer",
          "contextDecl",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "omegaModels",
              "allModels"
            ]
          },
          "layer": {
            "type": "string"
          },
          "contextDecl": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ambientGraph": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "comment": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "display"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "module": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "display": {
                "type": "object"
              },
              "statementVariant": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Cross-link only: ambient-graph identity remains the Lean declaration name."
              }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target",
              "direction",
              "certificate",
              "port",
              "scope"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "direction": {
                "enum": [
                  "upper",
                  "lower",
                  "exact"
                ]
              },
              "certificate": {
                "type": "string"
              },
              "port": {
                "type": "string"
              },
              "evidenceIdx": {
                "type": "integer"
              },
              "scope": {
                "const": "ambientFactorization"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "description": "Conceptual families (issue #3). Additive over principles until the #4 migration; concepts own no Lean proposition.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "display"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^reverse-mathlib:"
          },
          "description": {
            "type": "string"
          },
          "display": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "externalNamespaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "externalRefs": {
      "type": "array",
      "description": "Typed external references. Only relation=exactAlias participates in identity resolution.",
      "items": {
        "type": "object",
        "required": [
          "namespace",
          "key",
          "relation",
          "target"
        ],
        "properties": {
          "namespace": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "exactAlias",
              "sourceLocation",
              "importedCorrespondence",
              "relatedVariant"
            ]
          },
          "target": {
            "type": "object",
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "concept",
                  "statement",
                  "uniformProblem"
                ]
              },
              "id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "semanticLayers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "interfaceSchema",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "interfaceSchema": {
            "type": [
              "string",
              "null"
            ],
            "description": "Name of the type-valued Lean definition giving the expected interface type of variants at this layer; null keeps the ambient default (interfaces must be Prop-valued). Candidate interfaces are validated by definitional equality."
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "baseTheories": {
      "type": "array",
      "description": "Registered base theories for theory-context facts (issue #5). Extensible by registration.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "formulaClasses": {
      "type": "array",
      "description": "Registered formula classes parametrizing conservation facts (issue #5).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "reducibilityNotions": {
      "type": "array",
      "description": "Registered reducibility notions for uniform facts (issue #5). Extensible by registration, never a closed enum.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "description": "Typed facts (issue #5). FAIL-CLOSED: evidence is always [] until issue #6 links typed evidence, so a recorded fact is never rendered as supported and never participates in inference. RM facts (kind implication|equivalence|nonImplication|conservation|nonConservation) have theory contexts and normalized conjunctions of exact statement-variant ids as endpoints; uniform facts (reducibility|nonReducibility) have uniform contexts, single uniform-problem endpoints, and a mandatory degreeStatus. The two families never mix.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "context",
          "lhs",
          "rhs",
          "formulaClass",
          "degreeStatus",
          "note",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "implication",
              "equivalence",
              "nonImplication",
              "conservation",
              "nonConservation",
              "reducibility",
              "nonReducibility"
            ]
          },
          "context": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "theory",
                  "uniform"
                ]
              },
              "base": {
                "type": "string"
              },
              "scope": {
                "enum": [
                  "provability",
                  "omegaModels",
                  "allModels"
                ]
              },
              "notion": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "lhs": {
            "type": "array",
            "description": "Normalized (sorted, deduplicated) serialized statement-variant ids for RM facts; a single serialized uniform-problem id for uniform facts.",
            "items": {
              "type": "string",
              "pattern": "^reverse-mathlib:"
            }
          },
          "rhs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^reverse-mathlib:"
            }
          },
          "formulaClass": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present exactly on conservation kinds."
          },
          "degreeStatus": {
            "enum": [
              "exact",
              "representative",
              "variantSensitive",
              "notAssigned",
              null
            ],
            "description": "Mandatory on uniform kinds; null otherwise. representative is descriptive only — never an inference edge."
          },
          "note": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "description": "Registered fact certifications (revmath_certify_fact, #24). Base theory, scope, direction, and endpoints are derived from the fact itself; empty = recorded-but-unsupported, never rendered as certified.",
            "items": {
              "type": "object",
              "required": [
                "context",
                "certificate",
                "note"
              ],
              "properties": {
                "context": {
                  "type": "string",
                  "description": "The registered semantic context the certificate quantifies over."
                },
                "certificate": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "statementVariants": {
      "type": "array",
      "description": "Exact statement variants (issue #4). Parent concept is explicit data; a variant may own at most one Lean interface, whose type must match its layer's interface schema up to definitional equality (Prop for schema-less layers).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "concept",
          "layer",
          "interface",
          "description",
          "display"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^reverse-mathlib:"
          },
          "concept": {
            "type": "string",
            "pattern": "^reverse-mathlib:"
          },
          "layer": {
            "type": "string"
          },
          "interface": {
            "type": [
              "string",
              "null"
            ]
          },
          "interfaceModule": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "display": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "uniformProblems": {
      "type": "array",
      "description": "Represented uniform problems \u2014 deliberately shallow metadata until Q2-Q5.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "concept",
          "inputRepresentation",
          "outputRepresentation",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^reverse-mathlib:"
          },
          "concept": {
            "type": "string",
            "pattern": "^reverse-mathlib:"
          },
          "inputRepresentation": {
            "type": "string"
          },
          "outputRepresentation": {
            "type": "string"
          },
          "interface": {
            "type": [
              "string",
              "null"
            ]
          },
          "operation": {
            "enum": [
              "single",
              "finiteParallelization",
              "sequentialization"
            ]
          },
          "uniformizes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
